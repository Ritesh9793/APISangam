# API Marketplace Environment Variables
# Copy this file to .env and update with your actual values

# ============================================
# Database Configuration
# ============================================
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=api_marketplace
DB_HOST=localhost
DB_PORT=5432

# ============================================
# Redis/Valkey Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password

# ============================================
# ElasticSearch Configuration
# ============================================
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ============================================
# JWT Configuration
# ============================================
# Generate a secure 256-bit key: openssl rand -base64 32
JWT_SECRET=your_256_bit_secret_key_change_in_production_abc123xyz789
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30

# ============================================
# Razorpay Payment Gateway
# ============================================
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ============================================
# UPI Configuration
# ============================================
UPI_MERCHANT_ID=your_merchant_id
UPI_MERCHANT_NAME=API Marketplace

# ============================================
# Email Configuration (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=noreply@apimarketplace.com
SMTP_FROM_NAME=API Marketplace

# ============================================
# Application URLs
# ============================================
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
API_GATEWAY_URL=http://localhost:8000

# ============================================
# CORS Configuration
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# Security Configuration
# ============================================
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=1800000
PASSWORD_MIN_LENGTH=8

# ============================================
# Rate Limiting (per minute)
# ============================================
DEFAULT_RATE_LIMIT_PER_MINUTE=60
DEFAULT_RATE_LIMIT_PER_HOUR=1000
DEFAULT_RATE_LIMIT_PER_DAY=10000

# ============================================
# GST Configuration (India)
# ============================================
GST_RATE=0.18
PLATFORM_COMMISSION_PERCENTAGE=0.10

# ============================================
# KYC & Compliance
# ============================================
KYC_REQUIRED=true
GSTIN_VERIFICATION=true
PAN_VERIFICATION=true
KYC_PROVIDER_ENABLED=false
KYC_PROVIDER_PREFER_REMOTE=true
KYC_PROVIDER_BASE_URL=
KYC_PROVIDER_API_KEY=
KYC_PROVIDER_WEBHOOK_SECRET=
KYC_PROVIDER_BANK_ACCOUNT_PATH=/bank-account-verification
KYC_PROVIDER_PAN_PATH=/pan-verification
KYC_PROVIDER_GST_PATH=/gst-verification
KYC_PROVIDER_AADHAAR_BASIC_PATH=/basic-aadhaar-check
KYC_PROVIDER_AADHAAR_OCR_PATH=/aadhaar-ocr-check
KYC_PROVIDER_DRIVING_LICENSE_PATH=/driving-license-verification
KYC_PROVIDER_PASSPORT_PATH=/passport-verification
KYC_PROVIDER_VOTER_ID_PATH=/voter-id-verification
KYC_PROVIDER_FACE_MATCH_PATH=/face-match-api
KYC_PROVIDER_FACE_LIVENESS_PATH=/face-liveness-check-api

# ============================================
# Monitoring & Observability
# ============================================
GRAFANA_PASSWORD=admin
PROMETHEUS_RETENTION_DAYS=15

# ============================================
# Frontend Environment Variables
# ============================================
REACT_APP_API_URL=http://localhost:8080
REACT_APP_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
REACT_APP_ENV=development

# ============================================
# AWS Configuration (for production)
# ============================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=api-marketplace-documents

# ============================================
# SSL/TLS Configuration (for production)
# ============================================
SSL_ENABLED=false
SSL_CERTIFICATE_PATH=/etc/ssl/certs/certificate.crt
SSL_PRIVATE_KEY_PATH=/etc/ssl/private/private.key

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/api-marketplace.log
LOG_MAX_SIZE=10MB
LOG_MAX_HISTORY=30

# ============================================
# Feature Flags
# ============================================
FEATURE_MFA_ENABLED=true
FEATURE_EMAIL_VERIFICATION=true
FEATURE_AUTO_SETTLEMENT=false
FEATURE_API_ANALYTICS=true

# ============================================
# External API Integration
# ============================================
# Government APIs for verification
NSDL_PAN_VERIFICATION_URL=https://www.nsdl.co.in/pan-verification
GST_VERIFICATION_URL=https://gst.gov.in/verify

# SMS Gateway (Twilio/MSG91)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================
# Development & Testing
# ============================================
ENABLE_SWAGGER=true
ENABLE_H2_CONSOLE=false
MOCK_PAYMENT_GATEWAY=false
SKIP_EMAIL_VERIFICATION=false
